{
  "id": "garage_fan_cooling_off",
  "alias": "Garage Fan - Off (Empty 15min)",
  "description": "Turn off garage fans 15 minutes after presence clears.",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "binary_sensor.garage_presence_sensor_presence",
      "to": "off",
      "for": "00:15:00"
    }
  ],
  "condition": [
    {
      "condition": "state",
      "entity_id": "input_boolean.fan_user_claimed_garage",
      "state": "off"
    }
  ],
  "action": [
    {
      "service": "switch.turn_off",
      "target": {
        "entity_id": "switch.garage_fans"
      }
    }
  ],
  "mode": "single"
}
