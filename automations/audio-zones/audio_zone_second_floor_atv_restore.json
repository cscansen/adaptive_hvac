{
  "id": "audio_zone_second_floor_atv_restore",
  "alias": "Audio Zone - Second Floor Restore (Tia + Family Room ATV Both Stopped)",
  "description": "Re-enable second floor zone auto flag only when BOTH Tia's and Family Room ATV have stopped playing.",
  "trigger": [
    {
      "platform": "state",
      "entity_id": [
        "media_player.tias_office_apple_tv",
        "media_player.family_room_apple_tv"
      ],
      "to": ["idle", "off", "paused"]
    }
  ],
  "condition": [
    {
      "condition": "state",
      "entity_id": "media_player.tias_office_apple_tv",
      "state": ["idle", "off", "paused"]
    },
    {
      "condition": "state",
      "entity_id": "media_player.family_room_apple_tv",
      "state": ["idle", "off", "paused"]
    }
  ],
  "action": [
    {
      "service": "input_boolean.turn_on",
      "target": {
        "entity_id": "input_boolean.auto_audio_second_floor"
      }
    }
  ],
  "mode": "single"
}
