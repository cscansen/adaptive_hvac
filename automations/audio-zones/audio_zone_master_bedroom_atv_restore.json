{
  "id": "audio_zone_master_bedroom_atv_restore",
  "alias": "Audio Zone - Master Bedroom Restore (ATV Stopped)",
  "description": "Re-enable master bedroom zone auto flag when Master Bedroom ATV goes idle/off.",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "media_player.master_bedroom_apple_tv",
      "to": ["idle", "off"]
    }
  ],
  "action": [
    {
      "service": "input_boolean.turn_on",
      "target": {
        "entity_id": "input_boolean.auto_audio_master_bedroom"
      }
    }
  ],
  "mode": "single"
}
