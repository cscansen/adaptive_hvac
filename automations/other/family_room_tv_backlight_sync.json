{
    "id": "1768107735275",
    "alias": "Family Room TV Backlight - Sync",
    "description": "Turn TV backlight on/off with Apple TV playback state. Mirrors the other backlight automations: paused counts as active (light stays on), only off/idle/standby turns it off. A media_player stuck at paused for 20min unchanged is treated as effectively off. No boot/reconnect reconciliation — none of the other backlight automations need it either; removed after it forced the light on from a stale paused read on every HA restart.",
    "triggers": [
        {
            "id": "atv_active",
            "trigger": "state",
            "entity_id": "media_player.family_room_apple_tv",
            "to": [
                "playing",
                "paused",
                "buffering"
            ]
        },
        {
            "id": "atv_inactive",
            "trigger": "state",
            "entity_id": "media_player.family_room_apple_tv",
            "to": [
                "off",
                "idle",
                "standby"
            ]
        },
        {
            "id": "atv_stuck_paused",
            "trigger": "state",
            "entity_id": "media_player.family_room_apple_tv",
            "to": "paused",
            "for": {
                "minutes": 20
            }
        }
    ],
    "actions": [
        {
            "choose": [
                {
                    "conditions": [
                        {
                            "condition": "template",
                            "value_template": "{{ trigger.id == 'atv_active' }}"
                        }
                    ],
                    "sequence": [
                        {
                            "target": {
                                "entity_id": "light.h6169"
                            },
                            "action": "light.turn_on"
                        }
                    ]
                },
                {
                    "conditions": [
                        {
                            "condition": "template",
                            "value_template": "{{ trigger.id == 'atv_inactive' }}"
                        }
                    ],
                    "sequence": [
                        {
                            "target": {
                                "entity_id": "light.h6169"
                            },
                            "action": "light.turn_off"
                        }
                    ]
                },
                {
                    "conditions": [
                        {
                            "condition": "trigger",
                            "id": "atv_stuck_paused"
                        }
                    ],
                    "sequence": [
                        {
                            "target": {
                                "entity_id": "light.h6169"
                            },
                            "action": "light.turn_off"
                        }
                    ]
                }
            ]
        }
    ],
    "mode": "restart"
}
