{
  "id": "garage_fan_door_ventilation",
  "alias": "Garage Fan - Door Ventilation",
  "description": "Turn on garage fan when both bay doors have been open 5+ min and garage temp > 75°F. Off when either door closes and garage is empty.",
  "trigger": [
    {
      "platform": "template",
      "value_template": "{{ is_state('cover.lexus_garage_door', 'open') and is_state('cover.pony_garage_door', 'open') }}",
      "for": "00:05:00"
    },
    {
      "platform": "state",
      "entity_id": ["cover.lexus_garage_door", "cover.pony_garage_door"],
      "to": "closed"
    }
  ],
  "condition": [
    {
      "condition": "state",
      "entity_id": "input_boolean.fan_user_claimed_garage",
      "state": "off"
    },
    {
      "condition": "time",
      "after": "06:00:00",
      "before": "09:00:00"
    }
  ],
  "action": [
    {
      "choose": [
        {
          "conditions": [
            {
              "condition": "template",
              "value_template": "{{ is_state('cover.lexus_garage_door', 'open') and is_state('cover.pony_garage_door', 'open') }}"
            },
            {
              "condition": "numeric_state",
              "entity_id": "sensor.garage_hygrometer_temperature",
              "above": 60
            }
          ],
          "sequence": [
            {
              "service": "switch.turn_on",
              "target": {"entity_id": "switch.garage_fans"}
            }
          ]
        },
        {
          "conditions": [
            {"condition": "state", "entity_id": "cover.lexus_garage_door", "state": "closed"},
            {"condition": "state", "entity_id": "cover.pony_garage_door", "state": "closed"},
            {
              "condition": "state",
              "entity_id": "binary_sensor.garage_occupied",
              "state": "off"
            }
          ],
          "sequence": [
            {
              "service": "switch.turn_off",
              "target": {"entity_id": "switch.garage_fans"}
            }
          ]
        }
      ]
    }
  ],
  "mode": "single"
}
