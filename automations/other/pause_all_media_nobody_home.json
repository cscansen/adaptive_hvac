{
    "id": "1750000000001",
    "alias": "Media - Stop All When Nobody Home / Rearm On Arrival",
    "description": "Stop all media and disable dynamic audio when both leave. Re-enable dynamic audio when either returns. Uses binary_sensor.caleb_home / tia_home which aggregate all tracked devices per person.",
    "triggers": [
        {
            "id": "caleb_left",
            "trigger": "state",
            "entity_id": "binary_sensor.caleb_home",
            "to": "off"
        },
        {
            "id": "tia_left",
            "trigger": "state",
            "entity_id": "binary_sensor.tia_home",
            "to": "off"
        },
        {
            "id": "someone_home",
            "trigger": "state",
            "entity_id": [
                "binary_sensor.caleb_home",
                "binary_sensor.tia_home"
            ],
            "to": "on"
        }
    ],
    "actions": [
        {
            "choose": [
                {
                    "conditions": [
                        {
                            "condition": "trigger",
                            "id": "someone_home"
                        }
                    ],
                    "sequence": [
                        {
                            "action": "switch.turn_on",
                            "target": {
                                "entity_id": "switch.dynamic_central_audio_central_audio_active"
                            }
                        }
                    ]
                },
                {
                    "conditions": [
                        {
                            "condition": "state",
                            "entity_id": "binary_sensor.caleb_home",
                            "state": "off"
                        },
                        {
                            "condition": "state",
                            "entity_id": "binary_sensor.tia_home",
                            "state": "off"
                        }
                    ],
                    "sequence": [
                        {
                            "action": "media_player.media_stop",
                            "target": {
                                "entity_id": "all"
                            }
                        },
                        {
                            "action": "switch.turn_off",
                            "target": {
                                "entity_id": "switch.dynamic_central_audio_central_audio_active"
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "mode": "queued",
    "max": 2
}
