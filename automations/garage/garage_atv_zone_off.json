{
  "id": "garage_atv_zone_off_independent",
  "alias": "Garage ATV - Zone Off When Playing",
  "description": "When Garage Apple TV plays, drop garage from whole-house follow, turn off HTD zone, and turn amp ON. No AirPlay exception — local audio always overrides central.",
  "trigger": [
    {
      "platform": "state",
      "entity_id": "media_player.garage_apple_tv",
      "to": "playing"
    }
  ],
  "condition": [],
  "action": [
    {
      "service": "input_boolean.turn_off",
      "target": {
        "entity_id": "input_boolean.auto_audio_garage"
      }
    },
    {
      "service": "media_player.turn_off",
      "target": {
        "entity_id": "media_player.garage"
      }
    },
    {
      "service": "switch.turn_on",
      "target": {
        "entity_id": "switch.extra1"
      }
    }
  ],
  "mode": "single"
}
