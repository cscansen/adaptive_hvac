{
    "id": "1768107630248",
    "alias": "Family Room - Lights (Occupancy)",
    "description": "Turn on lights at full brightness when FP2 detects presence, but only when both sleep postures are off. Stay on if Apple TV playing.",
    "triggers": [
        {
            "id": "presence_detected",
            "entity_id": "binary_sensor.presence_sensor_fp2_0d3d_presence_sensor_2",
            "from": "off",
            "to": "on",
            "trigger": "state"
        },
        {
            "id": "presence_cleared",
            "entity_id": "binary_sensor.presence_sensor_fp2_0d3d_presence_sensor_2",
            "from": "on",
            "to": "off",
            "trigger": "state"
        }
    ],
    "actions": [
        {
            "choose": [
                {
                    "conditions": [
                        {
                            "condition": "trigger",
                            "id": "presence_detected"
                        },
                        {
                            "condition": "state",
                            "entity_id": "input_boolean.downstairs_sleep_posture",
                            "state": "off"
                        },
                        {
                            "condition": "state",
                            "entity_id": "input_boolean.master_suite_sleep_posture",
                            "state": "off"
                        }
                    ],
                    "sequence": [
                        {
                            "action": "light.turn_on",
                            "target": {
                                "entity_id": "light.family_room_lights"
                            },
                            "data": {
                                "brightness": 255
                            }
                        }
                    ]
                },
                {
                    "conditions": [
                        {
                            "condition": "trigger",
                            "id": "presence_cleared"
                        },
                        {
                            "condition": "not",
                            "conditions": [
                                {
                                    "condition": "state",
                                    "entity_id": "media_player.family_room_apple_tv",
                                    "state": "playing"
                                }
                            ]
                        }
                    ],
                    "sequence": [
                        {
                            "delay": {
                                "minutes": 2
                            }
                        },
                        {
                            "action": "light.turn_off",
                            "target": {
                                "entity_id": "light.family_room_lights"
                            }
                        }
                    ]
                }
            ]
        }
    ],
    "mode": "restart"
}
