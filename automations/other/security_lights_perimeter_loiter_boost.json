{
    "id": "security_lights_perimeter_loiter_boost",
    "alias": "Security Lights - Perimeter Loiter Boost",
    "description": "Reactive/energy-saving exterior lighting: turns on the fixture nearest a detected perimeter zone while dark, and off ~10min after all sensors feeding that fixture clear. Front Door Entry Lights stay on the fixed dusk/dawn schedule (security_lights label) unaffected by this automation.",
    "triggers": [
        {"platform": "state", "entity_id": "binary_sensor.front_door_person_detected", "to": "on", "id": "front_door_on"},
        {"platform": "state", "entity_id": "binary_sensor.back_field_person", "to": "on", "id": "back_field_on"},
        {"platform": "state", "entity_id": "binary_sensor.driveway_person_detected", "to": "on", "id": "driveway_on"},
        {"platform": "state", "entity_id": "binary_sensor.yard_west_person_detected", "to": "on", "id": "yard_west_on"},
        {"platform": "state", "entity_id": "binary_sensor.yard_east_person_detected", "to": "on", "id": "yard_east_on"},
        {"platform": "state", "entity_id": "binary_sensor.back_field_person", "to": "off", "for": "00:10:00", "id": "back_field_off"},
        {"platform": "state", "entity_id": "binary_sensor.driveway_person_detected", "to": "off", "for": "00:10:00", "id": "driveway_off"},
        {"platform": "state", "entity_id": "binary_sensor.yard_west_person_detected", "to": "off", "for": "00:10:00", "id": "yard_west_off"},
        {"platform": "state", "entity_id": "binary_sensor.yard_east_person_detected", "to": "off", "for": "00:10:00", "id": "yard_east_off"}
    ],
    "actions": [
        {
            "choose": [
                {
                    "conditions": [{"condition": "trigger", "id": "front_door_on"}, {"condition": "sun", "after": "sunset"}],
                    "sequence": [{"target": {"entity_id": "light.front_porch_cans"}, "action": "light.turn_on"}]
                },
                {
                    "conditions": [{"condition": "trigger", "id": "back_field_on"}, {"condition": "sun", "after": "sunset"}],
                    "sequence": [{"target": {"entity_id": "light.back_field_floodlight"}, "action": "light.turn_on"}]
                },
                {
                    "conditions": [{"condition": "trigger", "id": "driveway_on"}, {"condition": "sun", "after": "sunset"}],
                    "sequence": [
                        {"target": {"entity_id": "switch.shed_exterior_light"}, "action": "switch.turn_on"},
                        {"target": {"entity_id": "light.back_field_floodlight"}, "action": "light.turn_on"}
                    ]
                },
                {
                    "conditions": [{"condition": "trigger", "id": "yard_west_on"}, {"condition": "sun", "after": "sunset"}],
                    "sequence": [{"target": {"entity_id": "switch.shed_exterior_light"}, "action": "switch.turn_on"}]
                },
                {
                    "conditions": [{"condition": "trigger", "id": "yard_east_on"}, {"condition": "sun", "after": "sunset"}],
                    "sequence": [
                        {"target": {"entity_id": "light.gazebo_lights"}, "action": "light.turn_on"},
                        {"target": {"entity_id": "switch.gazebo_slider_lights"}, "action": "switch.turn_on"},
                        {"target": {"entity_id": "light.front_porch_cans"}, "action": "light.turn_on"}
                    ]
                },
                {
                    "conditions": [{"condition": "trigger", "id": "driveway_off"}],
                    "sequence": [
                        {
                            "if": [{"condition": "state", "entity_id": "binary_sensor.yard_west_person_detected", "state": "off"}],
                            "then": [{"target": {"entity_id": "switch.shed_exterior_light"}, "action": "switch.turn_off"}]
                        },
                        {
                            "if": [{"condition": "state", "entity_id": "binary_sensor.back_field_person", "state": "off"}],
                            "then": [{"target": {"entity_id": "light.back_field_floodlight"}, "action": "light.turn_off"}]
                        }
                    ]
                },
                {
                    "conditions": [{"condition": "trigger", "id": "yard_west_off"}],
                    "sequence": [
                        {
                            "if": [{"condition": "state", "entity_id": "binary_sensor.driveway_person_detected", "state": "off"}],
                            "then": [{"target": {"entity_id": "switch.shed_exterior_light"}, "action": "switch.turn_off"}]
                        }
                    ]
                },
                {
                    "conditions": [{"condition": "trigger", "id": "back_field_off"}],
                    "sequence": [
                        {
                            "if": [{"condition": "state", "entity_id": "binary_sensor.driveway_person_detected", "state": "off"}],
                            "then": [{"target": {"entity_id": "light.back_field_floodlight"}, "action": "light.turn_off"}]
                        }
                    ]
                },
                {
                    "conditions": [{"condition": "trigger", "id": "yard_east_off"}],
                    "sequence": [
                        {"target": {"entity_id": "light.gazebo_lights"}, "action": "light.turn_off"},
                        {"target": {"entity_id": "switch.gazebo_slider_lights"}, "action": "switch.turn_off"}
                    ]
                }
            ]
        }
    ],
    "mode": "queued",
    "max": 10
}
